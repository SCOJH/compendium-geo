<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Compendium.Adapters.GoogleMaps</AssemblyName>
    <RootNamespace>Compendium.Adapters.GoogleMaps</RootNamespace>
    <PackageId>Compendium.Adapters.GoogleMaps</PackageId>
    <Description>Google Maps Platform adapter for the Compendium framework. Implements IGeocoder (Geocoding API) and IRouteMatrixProvider (Distance Matrix API) from Compendium.Abstractions.Geo for real-route planning.</Description>
    <PackageTags>compendium;adapter;google-maps;geocoding;routing;geo</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Compendium.Core" />
    <PackageReference Include="Compendium.Abstractions" />
    <ProjectReference Include="..\Compendium.Abstractions.Geo\Compendium.Abstractions.Geo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Compendium.Adapters.GoogleMaps.Tests" />
  </ItemGroup>

</Project>
